# Скопируй в .env перед `docker compose up` и заполни.
# Все секреты сгенерируй командой: openssl rand -hex 32

# ------- Домены (только для продакшн-деплоя) -------
DOMAIN=egvoice.ru
LIVEKIT_DOMAIN=livekit.egvoice.ru
TURN_DOMAIN=turns.egvoice.ru
LETSENCRYPT_EMAIL=you@example.com

# ------- Секреты -------
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-hex

# ------- LiveKit -------
# openssl rand -hex 8
LIVEKIT_API_KEY=devkey
# openssl rand -hex 32
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdev12345
# Публичный WSS-URL LiveKit — клиенту
LIVEKIT_WS_URL=wss://livekit.egvoice.ru

# ------- TURN -------
# openssl rand -hex 24
TURN_SECRET=change-me-turn-secret

# ------- Приложение -------
DATABASE_PATH=/data/egvoice.db
NODE_ENV=production
PORT=5000
