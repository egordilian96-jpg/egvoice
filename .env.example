# Скопируй в .env перед `docker compose up`.
# Секреты сгенерируй: `openssl rand -hex 32`

JWT_SECRET=change-me-to-a-64-char-hex
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdev12345
# Публичный URL LiveKit для клиента; в prod — wss://<домен>
LIVEKIT_URL=wss://livekit.egvoice.ru
